<%- include("partials/header.ejs") %>

  <% if (locals.css && locals.title) { %>
    <link rel="stylesheet" href="/styles/<%= css %>">
    <title>
      <%= title %>
    </title>
    <% } %>
      <main>
        <section class="posts" aria-labelledby="posts-heading">
          <h2 id="posts-heading" class="posts__heading">Posts</h2>

          <% if (posts.length===0) { %>
            <p class="posts__empty">No posts yet. Create your first post to see it here.</p>
            <% } else { %>
              <ul class="post-list">
                <% posts.forEach((post)=> { %>
                  <li class="post">
                    <article class="post__body">
                      <h3 class="post__title">
                        <%= post.title %>
                      </h3>
                      <p class="post__content">
                        <%= post.content %>
                      </p>
                    </article>

                    <div class="post__actions">
                      <a class="btn btn--secondary" href="/update/<%= post.id %>">Edit</a>

                      <form action="/delete/<%= post.id %>" method="POST"
                        onsubmit="return confirm('Delete this post? This can’t be undone.');">
                        <button type="submit" class="btn btn--danger">Delete</button>
                      </form>
                    </div>
                  </li>
                  <% }); %>
              </ul>
              <% } %>
        </section>

      </main>

      <%- include("partials/footer.ejs") %>